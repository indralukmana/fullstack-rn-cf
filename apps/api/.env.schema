# @generateTsTypes(path='env.d.ts', auto=false)
# @defaultSensitive=false @defaultRequired=false @currentEnv=$ENVIRONMENT
# ---

# @type=enum(development, production) @required
ENVIRONMENT=development

# @type=string @required
SERVICE_NAME=rn-cf-api

# @sensitive @required @type=string(minLength=32)
BETTER_AUTH_SECRET=

# @type=url @required
BETTER_AUTH_URL=http://127.0.0.1:8787

# Public Expo web/app-link origin used in customer-facing links.
# @type=url @required
APP_URL=http://127.0.0.1:8081

# Comma-separated browser origins allowed for CORS (no trailing slash).
# @type=string @required=forEnv(production)
CORS_ORIGINS=http://localhost:8081,http://127.0.0.1:8081,http://localhost:19006,http://127.0.0.1:19006

# Extra Better Auth trusted origins (native schemes always included).
# @type=string
TRUSTED_ORIGINS=

# Global rate limit window (ms) and max requests per client key.
# @type=number @required
RATE_LIMIT_TTL=60000

# @type=number @required
RATE_LIMIT_MAX=120

# Stricter limits for /api/auth/*
# @type=number @required
AUTH_RATE_LIMIT_TTL=900000

# @type=number @required
AUTH_RATE_LIMIT_MAX=30

# Email delivery: console for local tests or Cloudflare Email Service in production.
# @type=enum(console, cloudflare) @required
EMAIL_PROVIDER=console

# Must belong to a domain onboarded to Cloudflare Email Service in production.
# @type=string
EMAIL_FROM=RN CF <noreply@localhost>

# Stripe server and webhook credentials.
# @sensitive @type=string @required=forEnv(production)
STRIPE_SECRET_KEY=

# @sensitive @type=string @required=forEnv(production)
STRIPE_WEBHOOK_SECRET=

# Exact Authorization header configured for RevenueCat webhooks.
# @sensitive @type=string @required=forEnv(production)
REVENUECAT_WEBHOOK_AUTHORIZATION=

# RevenueCat secret key for authoritative server-side reconciliation.
# @sensitive @type=string @required=forEnv(production)
REVENUECAT_SECRET_API_KEY=

# Canonical B2C product catalog. Keep provider IDs out of client requests.
# @type=string @required
BILLING_ENTITLEMENT_KEY=pro

# @type=number @required
BILLING_GRACE_PERIOD_DAYS=3

# Processed webhook payload retention and scheduled reconciliation batch size.
# @type=number @required
BILLING_EVENT_RETENTION_DAYS=30

# @type=number @required
BILLING_RECONCILIATION_LIMIT=50

# @type=string @required=forEnv(production)
STRIPE_PRICE_MONTHLY=price_test_monthly

# @type=string @required=forEnv(production)
STRIPE_PRICE_YEARLY=price_test_yearly

# @type=string @required
REVENUECAT_ENTITLEMENT_ID=pro

# @type=string @required
REVENUECAT_OFFERING_ID=default

# RevenueCat app IDs are verified on every webhook.
# @type=string @required=forEnv(production)
REVENUECAT_IOS_APP_ID=app_ios_test

# @type=string @required=forEnv(production)
REVENUECAT_ANDROID_APP_ID=app_android_test

# Expected store product IDs attached to the Pro entitlement.
# @type=string @required=forEnv(production)
REVENUECAT_IOS_PRODUCT_MONTHLY=pro_monthly

# @type=string @required=forEnv(production)
REVENUECAT_IOS_PRODUCT_YEARLY=pro_yearly

# @type=string @required=forEnv(production)
REVENUECAT_ANDROID_PRODUCT_MONTHLY=pro_monthly

# @type=string @required=forEnv(production)
REVENUECAT_ANDROID_PRODUCT_YEARLY=pro_yearly
