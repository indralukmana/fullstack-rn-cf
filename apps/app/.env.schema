# @generateTsTypes(path='env.d.ts', auto=false)
# @defaultSensitive=false @defaultRequired=false
# ---

# Public API base URL baked into the Expo bundle (non-sensitive).
# @type=url @required
EXPO_PUBLIC_API_URL=http://127.0.0.1:8787

# Web origin used for auth callback / redirect URLs (verification + password reset).
# @type=url @required
EXPO_PUBLIC_APP_URL=http://127.0.0.1:8081

# Public RevenueCat SDK keys. These are identifiers, not server secrets.
# @type=string @required
EXPO_PUBLIC_REVENUECAT_IOS_API_KEY=appl_test

# @type=string @required
EXPO_PUBLIC_REVENUECAT_ANDROID_API_KEY=goog_test

# Must match the server catalog.
# @type=string @required
EXPO_PUBLIC_BILLING_ENTITLEMENT_KEY=pro

# @type=string @required
EXPO_PUBLIC_REVENUECAT_OFFERING_ID=default
