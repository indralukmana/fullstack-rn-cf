{
  "name": "@rn-cf/app",
  "version": "1.0.0",
  "private": true,
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start --web --port 8081",
    "start": "expo start --port 8081",
    "android": "expo start --android --port 8081",
    "ios": "expo start --ios --port 8081",
    "web": "pnpm run dev",
    "export:web": "expo export --platform web",
    "env:codegen": "varlock codegen",
    "typecheck": "tsc --noEmit",
    "deploy": "pnpm export:web && wrangler pages deploy dist --project-name=rn-cf-web"
  },
  "dependencies": {
    "@better-auth/expo": "^1.6.23",
    "@expo-google-fonts/source-sans-3": "^0.4.1",
    "@expo-google-fonts/source-serif-4": "^0.4.1",
    "@expo/metro-runtime": "~57.0.3",
    "@rn-cf/api-client": "workspace:*",
    "@rn-cf/types": "workspace:*",
    "@tanstack/react-query": "^5.101.2",
    "@varlock/expo-integration": "^1.1.1",
    "better-auth": "^1.6.23",
    "expo": "~57.0.4",
    "expo-build-properties": "~57.0.7",
    "expo-constants": "~57.0.3",
    "expo-dev-client": "~57.0.9",
    "expo-font": "^57.0.1",
    "expo-linking": "~57.0.2",
    "expo-network": "~57.0.0",
    "expo-router": "~57.0.4",
    "expo-secure-store": "~57.0.0",
    "expo-status-bar": "~57.0.0",
    "expo-updates": "~57.0.10",
    "expo-web-browser": "~57.0.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-purchases": "^10.4.4",
    "react-native-purchases-ui": "^10.4.4",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.25.2",
    "react-native-web": "^0.21.2",
    "uniwind": "^1.0.0",
    "varlock": "^1.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.0",
    "wrangler": "^4.90.0"
  }
}
