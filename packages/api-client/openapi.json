{
  "openapi": "3.0.0",
  "info": {
    "title": "RN CF API",
    "version": "0.0.1"
  },
  "components": {
    "schemas": {
      "BillingStatusResponse": {
        "type": "object",
        "properties": {
          "entitlement": {
            "type": "string",
            "enum": ["pro"]
          },
          "hasAccess": {
            "type": "boolean"
          },
          "status": {
            "type": "string",
            "enum": ["active", "grace_period", "revoked", "expired"]
          },
          "expiresAt": {
            "type": "string",
            "nullable": true,
            "format": "date-time"
          },
          "grants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["stripe", "revenuecat"]
                },
                "status": {
                  "type": "string",
                  "enum": ["active", "grace_period", "revoked", "expired"]
                },
                "interval": {
                  "type": "string",
                  "enum": ["monthly", "yearly"]
                },
                "expiresAt": {
                  "type": "string",
                  "nullable": true,
                  "format": "date-time"
                },
                "managementUrl": {
                  "type": "string",
                  "nullable": true,
                  "format": "uri"
                }
              },
              "required": ["provider", "status", "interval", "expiresAt", "managementUrl"]
            }
          }
        },
        "required": ["entitlement", "hasAccess", "status", "expiresAt", "grants"]
      },
      "ErrorResponse": {
        "type": "object",
        "properties": {
          "error": {
            "type": "string",
            "example": "unauthorized"
          },
          "message": {
            "type": "string",
            "example": "Authentication required"
          }
        },
        "required": ["error", "message"]
      },
      "BillingUrlResponse": {
        "type": "object",
        "properties": {
          "url": {
            "type": "string",
            "format": "uri"
          }
        },
        "required": ["url"]
      },
      "CreateCheckoutRequest": {
        "type": "object",
        "properties": {
          "interval": {
            "type": "string",
            "enum": ["monthly", "yearly"]
          }
        },
        "required": ["interval"]
      },
      "ReconciliationResponse": {
        "type": "object",
        "properties": {
          "accepted": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "required": ["accepted"]
      },
      "AccountExportResponse": {
        "type": "object",
        "properties": {
          "exportedAt": {
            "type": "string",
            "format": "date-time"
          },
          "account": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "name": {
                "type": "string"
              },
              "email": {
                "type": "string",
                "format": "email"
              },
              "createdAt": {
                "type": "string",
                "format": "date-time"
              }
            },
            "required": ["id", "name", "email", "createdAt"]
          },
          "memberships": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "organizationId": {
                  "type": "string"
                },
                "role": {
                  "type": "string",
                  "enum": ["owner", "admin", "member"]
                }
              },
              "required": ["organizationId", "role"]
            }
          },
          "billingGrants": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "provider": {
                  "type": "string",
                  "enum": ["stripe", "revenuecat"]
                },
                "productId": {
                  "type": "string"
                },
                "interval": {
                  "type": "string",
                  "enum": ["monthly", "yearly"]
                },
                "status": {
                  "type": "string",
                  "enum": ["active", "grace_period", "revoked", "expired"]
                },
                "expiresAt": {
                  "type": "string",
                  "nullable": true,
                  "format": "date-time"
                }
              },
              "required": ["provider", "productId", "interval", "status", "expiresAt"]
            }
          }
        },
        "required": ["exportedAt", "account", "memberships", "billingGrants"]
      },
      "AccountDeletedResponse": {
        "type": "object",
        "properties": {
          "deleted": {
            "type": "boolean",
            "enum": [true]
          }
        },
        "required": ["deleted"]
      },
      "DeleteAccountRequest": {
        "type": "object",
        "properties": {
          "confirmation": {
            "type": "string",
            "enum": ["DELETE"]
          }
        },
        "required": ["confirmation"]
      },
      "FeatureItemListResponse": {
        "type": "object",
        "properties": {
          "items": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeatureItem"
            }
          }
        },
        "required": ["items"]
      },
      "FeatureItem": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "example": "item_123"
          },
          "organizationId": {
            "type": "string",
            "example": "org_123"
          },
          "featureKey": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]{1,31}$",
            "example": "notes"
          },
          "title": {
            "type": "string",
            "example": "First note"
          },
          "body": {
            "type": "string",
            "nullable": true,
            "example": "Optional details"
          },
          "createdByUserId": {
            "type": "string",
            "example": "user_123"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "id",
          "organizationId",
          "featureKey",
          "title",
          "body",
          "createdByUserId",
          "createdAt"
        ]
      },
      "CreateFeatureItemRequest": {
        "type": "object",
        "properties": {
          "title": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "body": {
            "type": "string",
            "maxLength": 4000
          }
        },
        "required": ["title"]
      },
      "HealthResponse": {
        "type": "object",
        "properties": {
          "status": {
            "type": "string",
            "enum": ["ok"],
            "example": "ok"
          },
          "service": {
            "type": "string",
            "example": "rn-cf-api"
          }
        },
        "required": ["status", "service"]
      },
      "MeResponse": {
        "type": "object",
        "properties": {
          "user": {
            "$ref": "#/components/schemas/MeUser"
          }
        },
        "required": ["user"]
      },
      "MeUser": {
        "type": "object",
        "nullable": true,
        "properties": {
          "id": {
            "type": "string",
            "example": "user_123"
          },
          "name": {
            "type": "string",
            "example": "Ada Lovelace"
          },
          "email": {
            "type": "string",
            "format": "email",
            "example": "ada@example.com"
          }
        },
        "required": ["id", "name", "email"]
      },
      "OrganizationContextResponse": {
        "type": "object",
        "properties": {
          "organization": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "example": "org_123"
              },
              "role": {
                "type": "string",
                "enum": ["owner", "admin", "member"]
              }
            },
            "required": ["id", "role"]
          }
        },
        "required": ["organization"]
      }
    },
    "parameters": {}
  },
  "paths": {
    "/api/billing/status": {
      "get": {
        "operationId": "getBillingStatus",
        "tags": ["Billing"],
        "responses": {
          "200": {
            "description": "Server-authoritative personal entitlement and provider grants",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingStatusResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Verified account or billing eligibility required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/checkout": {
      "post": {
        "operationId": "createStripeCheckout",
        "tags": ["Billing"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateCheckoutRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Stripe Checkout URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingUrlResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Verified account or billing eligibility required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "An entitlement or purchase is already active",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/portal": {
      "post": {
        "operationId": "createStripePortal",
        "tags": ["Billing"],
        "responses": {
          "200": {
            "description": "Stripe Customer Portal URL",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BillingUrlResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Verified account or billing eligibility required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "404": {
            "description": "No Stripe customer exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/billing/reconcile": {
      "post": {
        "operationId": "requestBillingReconciliation",
        "tags": ["Billing"],
        "responses": {
          "202": {
            "description": "Reconciliation accepted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReconciliationResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Verified account or billing eligibility required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/account/export": {
      "get": {
        "operationId": "exportAccountData",
        "tags": ["Account"],
        "responses": {
          "200": {
            "description": "Portable account, membership, and billing data",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountExportResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/account": {
      "delete": {
        "operationId": "deleteAccount",
        "tags": ["Account"],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/DeleteAccountRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Local account data deleted",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AccountDeletedResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Verified account required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "409": {
            "description": "Active store or Stripe subscription must be managed first",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/features/{featureKey}/items": {
      "get": {
        "operationId": "listFeatureItems",
        "tags": ["Features"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,31}$",
              "example": "notes"
            },
            "required": true,
            "name": "featureKey",
            "in": "path"
          }
        ],
        "responses": {
          "200": {
            "description": "Organization-scoped feature items",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureItemListResponse"
                }
              }
            }
          },
          "400": {
            "description": "Organization required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not a member of this organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      },
      "post": {
        "operationId": "createFeatureItem",
        "tags": ["Features"],
        "parameters": [
          {
            "schema": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9-]{1,31}$",
              "example": "notes"
            },
            "required": true,
            "name": "featureKey",
            "in": "path"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CreateFeatureItemRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created feature item",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FeatureItem"
                }
              }
            }
          },
          "400": {
            "description": "Organization required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "Not a member of this organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Health check",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/me": {
      "get": {
        "operationId": "getMe",
        "responses": {
          "200": {
            "description": "Current authenticated user, if any",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/private/ping": {
      "get": {
        "operationId": "getPrivatePing",
        "responses": {
          "200": {
            "description": "Authenticated ping",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          }
        }
      }
    },
    "/api/private/pro": {
      "get": {
        "operationId": "getProPing",
        "tags": ["Billing"],
        "responses": {
          "200": {
            "description": "Capability protected by the Pro entitlement",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required"
          },
          "403": {
            "description": "Pro entitlement required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/private/organization": {
      "get": {
        "operationId": "getOrganizationContext",
        "parameters": [
          {
            "schema": {
              "type": "string"
            },
            "required": false,
            "name": "x-organization-id",
            "in": "header"
          }
        ],
        "responses": {
          "200": {
            "description": "Verified organization context for the current user",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OrganizationContextResponse"
                }
              }
            }
          },
          "400": {
            "description": "No organization was selected",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "401": {
            "description": "Authentication required",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "403": {
            "description": "The user is not a member of the selected organization",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  }
}
