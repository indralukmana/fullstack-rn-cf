{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "tabWidth": 2,
  "useTabs": false,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": {
    "groups": [
      ["type-builtin", "builtin"],
      ["type-external", "external"],
      ["type-internal", "internal"],
      ["type-parent", "type-sibling", "type-index"],
      ["parent", "sibling", "index"],
      "unknown"
    ]
  },
  "ignorePatterns": [
    "**/node_modules/**",
    "**/dist/**",
    "**/build/**",
    "**/.astro/**",
    "**/.expo/**"
  ]
}
